---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import { formatDate, getCategoryHref, type Post } from '../lib/posts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  newer?: Post;
  older?: Post;
}

const { post, headings, newer, older } = Astro.props;
---

<BaseLayout
  title={post.title}
  description={post.description}
  type="article"
  publishedTime={post.date?.toISOString()}
  tags={post.tags}
>
  <article class="post">
    <header class="post-header">
      <nav class="breadcrumb" aria-label="面包屑">
        <a href="/">首页</a>
        <span aria-hidden="true">/</span>
        <a href={getCategoryHref(post.category)}>{post.categoryLabel}</a>
      </nav>

      <h1 class="post-title">{post.title}</h1>

      <div class="post-meta">
        {post.date ? (
          <time datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
        ) : (
          <span>日期待补</span>
        )}
        <span aria-hidden="true">·</span>
        <span>{post.readingTime} 分钟阅读</span>
        {post.tags.length > 0 && <TagList tags={post.tags} />}
      </div>
    </header>

    <div class="post-body">
      <TableOfContents headings={headings} />
      <div class="post-content prose">
        <slot />
      </div>
    </div>

    {(newer || older) && (
      <nav class="post-nav" aria-label="文章导航">
        {newer && (
          <a href={newer.href} rel="prev">
            <span>上一篇</span>
            <strong>{newer.title}</strong>
          </a>
        )}
        {older && (
          <a class="next" href={older.href} rel="next">
            <span>下一篇</span>
            <strong>{older.title}</strong>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
