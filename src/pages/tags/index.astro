---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getAllTags, getTagHref } from '../../lib/posts';

const posts = await getAllPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="标签" description="按标签浏览 Lehuang 的文章。">
  <div class="container">
    <header class="page-header">
      <p class="eyebrow">Tags</p>
      <h1>标签</h1>
      <p>共 {tags.length} 个标签。技术笔记通常按主题归类，方便顺着一条线读下去。</p>
    </header>

    {tags.length > 0 ? (
      <ul class="tag-cloud">
        {tags.map((tag) => (
          <li>
            <a href={getTagHref(tag.slug)}>
              {tag.name}
              <span class="tag-cloud-count">{tag.count}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">还没有标签。</p>
    )}
  </div>
</BaseLayout>
