---
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label={`${SITE.title} 首页`}>
      <img class="brand-avatar" src="/icon-head.png" width="30" height="30" alt="" />
      <span class="brand-name">{SITE.title}</span>
      <span class="brand-badge" aria-hidden="true">blog</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {NAV.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="icon-link" href="/rss.xml" aria-label="RSS 订阅">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 11a9 9 0 0 1 9 9"></path>
          <path d="M4 4a16 16 0 0 1 16 16"></path>
          <circle cx="5" cy="19" r="1"></circle>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
